" zaqar.vim — personal scheme, molokai-based
runtime colors/molokai.vim
let g:colors_name = "zaqar"

" personal tweaks
hi Comment      ctermfg=245 guifg=#8a8a8a   " brighter comments for long TS sessions
hi LineNr       ctermfg=240 guifg=#585858   " quieter gutter
hi CursorLineNr ctermfg=208 guifg=#ff8700   " current line pops
